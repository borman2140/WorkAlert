<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="#202631">

    <ImageView
        android:id="@+id/workalert_logo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/workalert_logo"
        android:contentDescription="WorkAlert WA" />

    <TextView
        android:id="@+id/action_stop"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/workalert_button_grey"
        android:gravity="center"
        android:text="×"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:fontFamily="sans"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/action_signal"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/workalert_button_red"
        android:gravity="center"
        android:text="SIGNÁL"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
