<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="#202631">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WorkAlert"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hlasitosť budíka"
            android:textColor="#C7CBD2"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/action_stop"
        android:layout_width="76dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/workalert_button_grey"
        android:gravity="center"
        android:text="VYPNÚŤ"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/action_signal"
        android:layout_width="92dp"
        android:layout_height="44dp"
        android:background="@drawable/workalert_button_red"
        android:gravity="center"
        android:text="SIGNÁL"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
